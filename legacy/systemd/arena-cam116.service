[Unit]
Description=Arena76 camera 116 to RTMP place7
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lazaryants
ExecStart=/home/lazaryants/arena76-streams/cam116-place7.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
