[Unit]
Description=Arena76 SRT publisher %i
Wants=network-online.target
After=network-online.target mediamtx.service
Requires=mediamtx.service

[Service]
Type=simple

User=arena-stream
Group=arena-stream

LoadCredential=publisher.env:/etc/arena-srt/publisher.env
EnvironmentFile=/etc/arena76/srt-streams/%i.env
Environment=HOME=/var/lib/arena-stream
Environment=XDG_CACHE_HOME=/var/cache/arena-stream
Environment=XDG_CONFIG_HOME=/var/lib/arena-stream/config

ExecStart=/usr/bin/python3 \
  /usr/local/lib/arena76/srt-worker.py \
  ${SOURCE_PATH} \
  ${REMOTE_PATH}

Restart=always
RestartSec=5s

TimeoutStopSec=15s
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arena-stream /var/cache/arena-stream
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
